# OpenButler settings — TEMPLATE. Copy to `.env` and adjust
# (`openbutler-setup init` does this for you).
# `.env` is local-only (gitignored, never commit). No secrets here, ever:
# keys live in the OS keychain / provider auth, never in files.
#
# Copy this folder anywhere, rename it freely: scripts derive the
# home from the `.env` location, and $HOME from the environment.
#
# Layout this describes:
#   $AGENT_HOME/                  this folder (the whole product)
#     crates/                     Rust workspace (voice, face, board, stt, tts, setup)
#     ui/face/                    face web UI (served verbatim, no build step)
#     ui/board/                   board web UI (served verbatim, no build step)
#     configs/                    live JSON (gitignored, rendered from below)
#     bus/ state/ logs/           runtime files (gitignored, recreated)
#   $MEMORY_VAULT                 memory vault (Obsidian). Next to the
#                                 home, never inside it.

# Folder containing this file == the agent home. Works no matter where
# the home is cloned.
AGENT_HOME="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# Who lives here (greetings, ring labels, quit phrases).
AGENT_NAME="Assistant"

# Memory vault (Obsidian). JSON configs are generated from this value
# by `openbutler-setup init` — do not hand-edit them.
MEMORY_VAULT="$HOME/openbutler-vault"

# Toolbox container for heavy builds (Toolbx/Podman). Interactive runs
# happen on the host; the container is build-only.
VOICE_CONTAINER="openbutler"

# Localhost ports (loopback only, servers bind 127.0.0.1).
FACE_PORT="8790"
HANDS_PORT="8794"

# Face + voice defaults (generic; override in `.env` or JSON).
FACE_NAME="board"
VOICE_NAME="bm_lewis"
STT_MODEL="small.en"
GREETING="Hey, good to see you. What are we working on?"

# Upstream attribution (white-label: point at your own fork).
UPSTREAM_ORG="your-org"
COPYRIGHT_HOLDER="Your Name"
